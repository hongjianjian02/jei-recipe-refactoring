# Auto detect text files and perform LF normalization
* text=auto

*.java text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.json text eol=lf
*.mcmeta text eol=lf
*.toml text eol=lf
*.md text eol=lf
.editorconfig text eol=lf
.gitattributes text eol=lf
gradlew text eol=lf
*.bat text eol=crlf
